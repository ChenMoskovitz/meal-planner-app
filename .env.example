# Copy to .env and fill in. .env is gitignored.

# Supabase project — Settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Edamam Food Database API — used by the ingredient search in the pantry
VITE_EDAMAM_FOOD_ID=
VITE_EDAMAM_FOOD_KEY=

# Edamam Nutrition Analysis API — used by fetchNutrition in src/utils/apiTest.js
VITE_EDAMAM_APP_ID=
VITE_EDAMAM_APP_KEY=

# A seeded Supabase account for the Playwright suite.
# WARNING: the suite deletes every row this account owns at the start of each run.
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# The account the MCP server signs in as. Must NOT be the TEST_USER_* one above.
MEAL_PLANNER_EMAIL=
MEAL_PLANNER_PASSWORD=
